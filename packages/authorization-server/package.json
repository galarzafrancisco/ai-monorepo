{
  "name": "@taico/authorization-server",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "license": "PolyForm-Small-Business-1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js",
      "default": "./dist/express.js"
    },
    "./nest": {
      "types": "./dist/nest.d.ts",
      "import": "./dist/nest.js",
      "default": "./dist/nest.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js",
      "default": "./dist/mcp.js"
    },
    "./storage/memory": {
      "types": "./dist/storage/memory.d.ts",
      "import": "./dist/storage/memory.js",
      "default": "./dist/storage/memory.js"
    },
    "./storage/sqlite": {
      "types": "./dist/storage/sqlite.d.ts",
      "import": "./dist/storage/sqlite.js",
      "default": "./dist/storage/sqlite.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:prod": "npm run build && npm run test:app",
    "test": "npm run test:app",
    "test:app": "tsx test-app/index.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "pack": "npm run build && npm pack",
    "release": "npm run build && npm publish --access public"
  },
  "dependencies": {
    "jose": "^6.1.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "tsx": "4.21.0",
    "typescript": "^5.7.3"
  }
}
