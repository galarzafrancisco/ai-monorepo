meta {
  name: Create Scheduled Task
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}{{apiPrefix}}/scheduled-tasks
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "taskBlueprintId": "{{taskBlueprintId}}",
    "cronExpression": "0 9 * * 1-5",
    "enabled": true
  }
}
