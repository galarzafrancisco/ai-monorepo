meta {
  name: Create Secret
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}{{apiPrefix}}/secrets
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "BRUNO_EXAMPLE_SECRET",
    "description": "Example secret created from Bruno",
    "value": "replace-me"
  }
}
