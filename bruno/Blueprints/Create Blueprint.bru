meta {
  name: Create Blueprint
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}{{apiPrefix}}/task-blueprints
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Bruno recurring task",
    "description": "Blueprint created from Bruno",
    "tagNames": ["{{tagName}}"]
  }
}
