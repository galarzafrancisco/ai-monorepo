meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}{{apiPrefix}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  const body = res.getBody();
  const token = body?.accessToken || body?.token || body?.access_token;
  if (token) {
    bru.setEnvVar("accessToken", token);
  }
}
