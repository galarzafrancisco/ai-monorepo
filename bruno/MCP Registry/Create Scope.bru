meta {
  name: Create Scope
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}{{apiPrefix}}/mcp/servers/{{serverId}}/scopes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "id": "{{scopeId}}",
    "description": "Read access to demo tools"
  }
}
